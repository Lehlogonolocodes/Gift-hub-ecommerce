<!DOCTYPE html>
<html>
<head><title>Gift Hub Calculator</title>
<style>
body{font-family:Arial; display:flex; justify-content:center; margin-top:50px}
.calc{background:#222; padding:20px; border-radius:15px; width:250px}
#screen{width:100%; height:50px; font-size:24px; text-align:right; margin-bottom:10px}
button{width:56px; height:56px; margin:3px; font-size:18px; border-radius:10px; border:none}
.eq{background:orange; color:white}
</style>
</head>
<body>
<div class="calc">
<input id="screen" disabled>
<div>
<button onclick="press('7')">7</button><button onclick="press('8')">8</button><button onclick="press('9')">9</button><button onclick="press('/')">/</button>
<button onclick="press('4')">4</button><button onclick="press('5')">5</button><button onclick="press('6')">6</button><button onclick="press('*')">x</button>
<button onclick="press('1')">1</button><button onclick="press('2')">2</button><button onclick="press('3')">3</button><button onclick="press('-')">-</button>
<button onclick="press('0')">0</button><button onclick="press('.')">.</button><button onclick="calc()" class="eq">=</button><button onclick="press('+')">+</button>
<button onclick="clearS()" style="width:100%; background:red; color:white">CLEAR</button>
</div>
</div>
<script>
let s=document.getElementById('screen');
function press(v){s.value+=v}
function calc(){try{s.value=eval(s.value)}catch{s.value='Error'}}
function clearS(){s.value=''}
</script>
</body>
</html>
